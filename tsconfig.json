{
  // Конфиг СУЩЕСТВУЕТ РАДИ РЕДАКТОРА, а не ради сборки.
  //
  // Собирает систему Vite (`npm run build`), пути он знает из `vite.config.ts`.
  // Языковой сервер VSCode этот файл не читает, поэтому без `paths` ниже он не
  // находил ни `@vtt/shared`, ни `@/…` и сыпал `TS2307` на каждый импорт. Дальше
  // рушились типы по цепочке: `Actor` становился ошибочным, и любой
  // `.map((entry) => …)` по нему получал implicit any.
  //
  // ⚠️ `target` здесь НАМЕРЕННО отсутствует, не добавляйте его.
  // esbuild внутри Vite читает этот файл при трансформации TS и выводит из
  // `target` значение `useDefineForClassFields`, а оно меняет семантику полей
  // класса (`[[Define]]` вместо `[[Set]]`) — это разное поведение при
  // наследовании, а `src/server` расширяет класс системы. У двух наших сборок
  // цели РАЗНЫЕ (клиент — браузерная у Vite, сервер — `node20` в
  // `scripts/build-server.mjs`), и общий `target` неизбежно ломает одну из них.
  // Без него каждая сборка остаётся при своей. Проверено сравнением хешей
  // `dist/` до и после появления файла: бандлы побайтово совпадают.
  //
  // Современные типы редактору даёт `lib` — его esbuild не читает.
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // Без `target` TypeScript считает целью ES5 и ругается на `for…of` по
    // Map/Set (TS2802). Ставим флаг напрямую — esbuild его не читает, значит
    // на бандл он не влияет, в отличие от `target`.
    "downlevelIteration": true,
    // `import.meta.glob` — расширение Vite, без его типов TS его не знает.
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,

    // Строгость по §227: `any` в проекте запрещён, ловить его должен редактор.
    "strict": true,

    "paths": {
      // Движок правил живёт в этой же репе и инлайнится в бандл —
      // зеркало алиаса из `vite.config.ts`.
      "@vtt/shared/system/dnd.js": ["./src/engine/index.ts"],

      // Нейтральное ядро приложения. В рантайме его отдаёт хост, а `sdk/` —
      // его вендорная копия, ровно для этого и лежит. Типы берём оттуда.
      "@vtt/shared": ["./sdk/index.ts"],

      // Ссылки системы на свои же файлы (46 legacy-мест).
      "@/systems/dnd5e/*": ["./src/client/*"]

      // ⚠️ Путей на монорепу VTTG здесь НЕТ и быть не должно.
      //
      // Репозиторий собирается ВНЕ приложения и не имеет права ничего оттуда
      // тянуть — ни для сборки, ни для проверки типов. Путь вида
      // `../vttg/packages/client/src/*` завязал бы репозиторий на чужую
      // раскладку каталогов на конкретной машине.
      //
      // Следствие честное: `@/…` и `pinia` в редакторе остаются
      // неразрешёнными (TS2307), а типы, идущие через них, — неточными.
      // Иначе и не может быть: у этих модулей нет локального исходника, они
      // внешние и приходят в рантайме из `globalThis.__VTTHost`. Закрыть это
      // может только опубликованный SDK-пакет с типами — ровно тот пробел,
      // что перечислен в README, § «Чего не хватает для полноценного SDK».
      // Писать заглушки `declare module '@/*'` с `any` тоже нельзя: §228.
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "sdk/**/*.ts",
    "auto-imports.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
